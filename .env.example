# 阿里云容器镜像
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=

# 数据库
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=interview_ai

# JWT 认证
JWT_SECRET=
COOKIE_SECURE=false

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DashScope 语音识别
DASHSCOPE_API_KEY=

# LangSmith 可观测性（LangChain 自动追踪）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-ai

# 前端
NEXT_PUBLIC_BASE_URL=
